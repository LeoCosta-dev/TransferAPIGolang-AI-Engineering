#!/bin/sh
# Pre-commit: formatação, golangci-lint e testes unitários de ambos os serviços.
# go test -race fica reservado para o CI para manter o hook rápido.
set -e

cd "$(git rev-parse --show-toplevel)"

echo "==> gofmt"
unformatted=$(gofmt -l services)
if [ -n "$unformatted" ]; then
	echo "Arquivos não formatados:"
	echo "$unformatted"
	echo "Corrija com: gofmt -w services"
	exit 1
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "golangci-lint não encontrado no PATH."
	echo "Instale a versão fixada v2.13.2: https://golangci-lint.run/welcome/install/"
	exit 1
fi

# O workspace (go.work) exige que os comandos rodem dentro de cada módulo.
for service in account transactions; do
	echo "==> golangci-lint ($service)"
	(cd "services/$service" && golangci-lint run)
done

for service in account transactions; do
	echo "==> go test ($service)"
	(cd "services/$service" && go test ./...)
done

echo "Pre-commit OK."